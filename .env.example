# Copy to .env and fill in as needed. All values have safe defaults.

# --- Database ---
DATABASE_URL=postgresql+psycopg://nexusz:nexusz@localhost:5432/nexusz
REDIS_URL=redis://localhost:6379/0

# --- Event bus ---
EVENT_BUS_BACKEND=inproc
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Simulator ---
SIMULATOR_ENABLED=true
TELEMETRY_INTERVAL_S=4
HAZARD_INTERVAL_S=20

# --- IBM Z transactional boundary (see infra/ibm_z/README_IBM_Z_INTEGRATION.md) ---
IBM_Z_INTEGRATION_ENABLED=false
IBM_Z_ENDPOINT_URL=
IBM_Z_CLIENT_CERT_PATH=

# --- Explanation Service ---
# Optional. Without this, explanations use a deterministic template fallback.
ANTHROPIC_API_KEY=
EXPLANATION_MODEL=claude-sonnet-4-6
